# ---------------------------------------------------------------------------
# .env.tp2-full -- GLM-5.3-Flash FULL-SCOPE EXL3 on TWO nodes: TP=2, expert
# parallelism OFF, DFlash2 k=7, per-rank fast-load sidecar.
#
# This is the TP=2 production candidate measured on 6 September 2026
# (docs/15-tp2-track.md section 5, results/speed/tp2-production-candidate.md):
# KV pool 2,128,571 tokens at max_model_len 1,000,000, C1 58.5 tok/s aggregate
# (62.6 per stream), C8 155.8, boot 272 s, gates 10/10 / 12/12 / 8/8.
#
# Read env.tp3.example first: the NCCL notes, the block-size reasoning and the
# reasoning-effort note are there and apply unchanged. What follows is only what
# two ranks change, plus the four settings that are not optional here.
#
# ONE COPY PER NODE, derived on that node with sed, NEVER copied between nodes.
# Two lines differ per node (NODE_RANK, HOST_IP) and a copied file that keeps
# the wrong rank produces a cluster where two processes believe they are the
# same rank. The rendezvous completes, the engine starts, the output is wrong.
#
# Placeholders to replace:
#   @NODE_RANK@    0 on the head node, 1 on worker-1
#   @HOST_IP@      this node's own management address
#   @HEAD_IP@      the head node's management address (same on both)
#   @IFACE@        the management network interface name
#   @HOME@         this node's home directory
#   @CKPT@         the full-scope checkpoint directory on this node
#   @DRAFT@        the DFlash2 drafter directory on this node
#
# Consumed by scripts/start-tp2full.sh. Launch order: rank 1, then rank 0.
# ---------------------------------------------------------------------------

NODE_RANK=@NODE_RANK@
HOST_IP=@HOST_IP@

# MASTER_ADDR is the MANAGEMENT address of rank 0. A fabric (RoCE) address hangs
# the rendezvous silently; set FABRIC_PREFIX in the environment and the launcher
# refuses one outright.
MASTER_ADDR=@HEAD_IP@
MASTER_PORT=29531
GLOO_IFACE=@IFACE@
TRANSPORT=mesh

NNODES=2
TP_SIZE=2

# OPTIONAL at two ranks, and off in every arm we have measured. The routed
# expert trellis is 2048 wide and 2048/2 = 1024 = 8 x 128, so it tensor-slices
# cleanly; at TP=3 it does not and EP is mandatory. preflight-tp3.py owns this
# arithmetic and will accept either value here. ENABLE_EP=1 at two ranks is
# legal and UNMEASURED -- docs/15 section 6.
ENABLE_EP=0

PORT=8001
SERVED_MODEL_NAME=glm-5.3-flash
QUANTIZATION=exl3
ATTENTION_BACKEND=CUSTOM
KV_CACHE_DTYPE=fp8

# 0.85 is where every TP=2 arm of ours has run, and it is NOT the three-node
# production rung (0.83). Do not copy either number across rank counts: the
# memory left after a fixed cost is not linear in the node count, the ladder has
# never been derived at two ranks, and our first two-node arm recorded 3.5 GB of
# swap on the head during weight load at exactly this rung. docs/15 section 6.
GPU_MEMORY_UTILIZATION=0.85

# Reachable at two ranks with either checkpoint once HAREM_SW_BLOCK_SIZE=256 and
# the launcher's settle gate are both in place. Without them the full-scope
# checkpoint fails its own KV budget gate here -- docs/15 section 5.5.
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=2048
ENFORCE_EAGER=0
LANGUAGE_MODEL_ONLY=1
REASONING_PARSER=deepseek_r1
REASONING_EFFORT=low
CPUSET=5-9,15-19

SPEC_METHOD=dflash
SPEC_TOKENS=7

# Two ranks need no image newer than the loader patch; exl3-zeus:62f53e6 is
# enough. 754421f is used so that both tracks share one image -- and therefore
# one sidecar-invalidation event, since the image tag is part of the manifest.
IMAGE=exl3-zeus:754421f

# No padding sidecar at two ranks: point MODEL_HOST_PATH at the checkpoint
# itself, give MODEL_PATH a plain container path, and leave MODEL_LINK_TARGET
# unset. The DFlash2 drafter's GQA is 32/8, which divides by two, so its 36/9
# TP=3 sidecar is not needed either.
MODEL_HOST_PATH=@CKPT@
MODEL_PATH=/models/glm-5.3-flash-exl3-full
DRAFT_HOST_PATH=@DRAFT@
DRAFT_PATH=/models/dflash2-draft

OVERLAY_DIR=@HOME@/exl3-zeus/overlay
NCCL_MESH_PLUGIN_DIR=@HOME@/nccl-mesh
CHAT_TEMPLATE_HOST=@HOME@/exl3-zeus/chat_template.jinja
PRELUDE_DIR=@HOME@/exl3-zeus/tp2full

# HAREM_DISABLE_PERSISTENT_TOPK=1  mandatory on GB10 at any rank count: vLLM's
#     sparse indexer picks a kernel that wants 85 CTAs against 48 SMs and a
#     fallback that wants >=128 KB of shared memory where the part has 101,376.
# NCCL_MAX_NCHANNELS=8             a plugin property, not a peer-count property.
# CUDA_EXL3_TUNE_CACHE=/cache/tune  warm it before measuring anything (docs/12).
# NCCL_MESH_LINKS_PER_PEER=0       auto. With two cables between the pair, both
#     of them carry ~90 GB across a sweep -- measured at two ranks, docs/15 5.4.
#     Set it to 1 if your pair has one cable; that makes patches/kernel/0005 a
#     no-op.
# HAREM_SW_BLOCK_SIZE=256          MANDATORY IN PRACTICE. Without it the pool is
#     601,562 and a 6,253-token prompt is never scheduled at all. docs/15 4.
# HAREM_DRAFT_KV_DTYPE=fp8         +15.1 % of pool at two ranks, speed and
#     acceptance unchanged, CUDA graphs still capture. docs/15 5.3.
# HAREM_TILELANG_FAILLOUD=1        a silent suppress becomes a named error.
# HAREM_EXL3_FULLSCOPE=1           patch-fullscope-tp2.py: S1 packed mapping,
#     S2 attention dtype, S3 KDA split. REMOVE THIS ONE LINE to serve the
#     routed-experts-only checkpoint instead (and drop --hf-overrides below).
EXTRA_ENV="HAREM_DISABLE_PERSISTENT_TOPK=1 NCCL_MAX_NCHANNELS=8 CUDA_EXL3_TUNE_CACHE=/cache/tune NCCL_MESH_LINKS_PER_PEER=0 NCCL_MESH_MIN_RNR_TIMER=1 NCCL_MESH_PTR_CUDA=1 NCCL_MESH_FLUSH=1 HAREM_SW_BLOCK_SIZE=256 HAREM_DRAFT_KV_DTYPE=fp8 HAREM_TILELANG_FAILLOUD=1 HAREM_EXL3_FULLSCOPE=1"

# SINGLE QUOTES, and NO SPACES inside the JSON: in double quotes the shell eats
# the JSON's own quotes. --hf-overrides is not about padding -- the full-scope
# checkpoint's inlined quantization config carries no tensor_storage, so
# cuda-exl3 has to be pointed at the standalone file. At two ranks that file is
# the checkpoint's own, unrewritten.
# NOTE what is ABSENT: --enable-ep-weight-filter. It needs expert parallelism.
EXTRA_ARGS='--block-size 256 --safetensors-load-strategy eager --no-enable-flashinfer-autotune --hf-overrides {"quantization_config_file":"/models/glm-5.3-flash-exl3-full/quantization_config.json"}'

# Per-rank pre-sliced sidecar. Boot 997 s -> 272 s.
# FASTLOAD_MODE=dump on the FIRST boot only; then change it to load.
# DISK: at two ranks EP is off, so every rank holds HALF of every tensor --
# about 75-83 GB per rank against 53 GB at three ranks with EP. Check
# "df -h /var/tmp" first: checkpoint plus sidecar needs ~240 GB free per node.
FASTLOAD_DIR=/var/tmp/glm53-exl3-tp2full
FASTLOAD_MODE=load
FASTLOAD_VERIFY=32
FASTLOAD_SHARD_BYTES=2147483648

# Uncomment to prove which modules are EXL3 and which stayed bf16. The
# full-scope candidate prints 203 EXL3 / 113 bf16; the routed-experts-only one
# prints the shared expert, o_proj and lm_head as "unquantized".
# CUDA_EXL3_DEBUG_NAMES=1

# Torch profiler. Off unless set: this vLLM takes it as --profiler-config and
# NOT as VLLM_TORCH_PROFILER_DIR, and with the environment variable alone
# /start_profile answers 404.
# PROFILER_DIR=/cache/prof
