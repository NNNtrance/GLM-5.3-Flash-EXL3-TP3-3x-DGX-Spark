# ---------------------------------------------------------------------------
# .env.tp3 -- GLM-5.3-Flash EXL3, TP=3 + expert parallel + DFlash2 k=7.
#
# ONE COPY PER NODE, and only two lines differ between them: NODE_RANK and
# HOST_IP. Do NOT copy a finished file from one node to another -- derive each
# node's copy from this template with sed. See envs/README.md.
#
# Placeholders to replace:
#   @NODE_RANK@    0 on the head node, 1 on worker-1, 2 on worker-2
#   @HOST_IP@      this node's own management address
#   @HEAD_IP@      the head node's management address (same value on all three)
#   @IFACE@        the management network interface name (same on all three here)
#   @HOME@         this node's home directory; $HOME works if you source the file
#
# Consumed by scripts/start-tp3.sh. Launch order: rank 2, then 1, then 0.
# ---------------------------------------------------------------------------

NODE_RANK=@NODE_RANK@
HOST_IP=@HOST_IP@

# MASTER_ADDR is the MANAGEMENT address of rank 0. A fabric (RoCE) address hangs
# the rendezvous silently rather than failing; set FABRIC_PREFIX (below) and the
# launcher refuses one outright.
MASTER_ADDR=@HEAD_IP@
MASTER_PORT=29531
GLOO_IFACE=@IFACE@
FABRIC_PREFIX=
TRANSPORT=mesh

# --- Parallelism ------------------------------------------------------------
NNODES=3
TP_SIZE=3
# Mandatory at TP=3. The EXL3 routed-expert trellis is 2048 wide; 2048/3 is not
# an integer, let alone a multiple of the 128-element Hadamard block a slice has
# to respect, so the experts are distributed whole (96 of 288 per rank) instead
# of being sliced. The launcher and the preflight both refuse ENABLE_EP=0 here.
# See docs/03.
ENABLE_EP=1

# --- Model and drafter ------------------------------------------------------
# Both sidecars are trees of RELATIVE symlinks into their link target, so
# start-tp3.sh mounts each at its own host path (identity mount) and refuses any
# other arrangement. Do NOT set MODEL_PATH / DRAFT_PATH. See docs/03.
MODEL_HOST_PATH=/var/tmp/glm-5.3-flash-tr3-4bpw-tp3
MODEL_LINK_TARGET=/var/tmp/glm-5.3-flash-tr3-4bpw
DRAFT_HOST_PATH=/var/tmp/dflash2-draft-tp3
DRAFT_LINK_TARGET=/var/tmp/dflash2-draft

# Speculative decoding. none | mtp | dflash.
# k=7 measured against k=5 on this stack: k=5 raises the acceptance RATE
# (63 -> 73 %) but lowers accepted tokens per STEP (5.5 -> 4.7), and the second
# effect wins everywhere except prose and C4. See docs/04.
SPEC_METHOD=dflash
SPEC_TOKENS=7

# --- Serving ----------------------------------------------------------------
PORT=8001
SERVED_MODEL_NAME=glm-5.3-flash
QUANTIZATION=exl3
# cuda-exl3's fused sparse-MLA backend. Not optional on this checkpoint.
ATTENTION_BACKEND=CUSTOM
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=8
# 2048 vs 4096: 4096 buys +9.5 % on fresh prefill and -13 % on mixed-load TTFT
# but costs 28.5 % of the KV pool. We chose 2048. 3072 was never tried. docs/07.
MAX_NUM_BATCHED_TOKENS=2048
# CUDA graphs ON. Both upstream recipes run graphs with a k=7 draft, and the
# "eager is faster" belief on this hardware came from a different image. docs/11.
ENFORCE_EAGER=0
# The vision tower is never executed here, and at TP=3 building it is fatal
# (divide(16, 3) asserts). The upstream flag alone does not stop it being built;
# patches/tp3/patch-vllm-tp3.py makes it honoured. docs/03.
LANGUAGE_MODEL_ONLY=1
REASONING_PARSER=deepseek_r1
REASONING_EFFORT=low
# Pin the engine to physical cores and leave the rest to the host.
CPUSET=5-9,15-19

# --- Memory -----------------------------------------------------------------
# 0.80 is the production value. 0.85 measured a 19 % larger KV pool and put the
# head node at 1.9 GiB free with 1.6 GB of swap in use, which breaks the 4 GiB
# rule, so it was rejected. Climb this ladder yourself, one rung at a time, with
# free memory and swap checked at each rung. 0.83 is designed and costed here
# (+3.65 GiB of budget, about +11 % of pool, head node down to ~8.4 GB free)
# and has not been run. docs/07 section 6.
GPU_MEMORY_UTILIZATION=0.80

# Host-side memory settle gate, read by scripts/start-tp3.sh, in GiB. After
# "docker rm -f" the launcher waits for /proc/meminfo MemAvailable to come back
# above this before starting the new container. It buys ZERO tokens: vLLM sizes
# the pool from a DELTA against the memory free at startup, so a node that
# starts dirty computes itself a bigger pool, and the last node started is the
# one the kernel has had least time to reclaim for. Without the gate the pool
# drifted 6 % between boots of an unchanged configuration and the ranks began
# 9 GiB apart; with it, 1.4 GiB. docs/07 section 1.1, docs/08 section 5.1.
SETTLE_MIN_GIB=112

# --- Image and overlays -----------------------------------------------------
# Production configuration 8. 62f53e6 carries a47da6e ("take the 64-bit divide
# out of the MoE input transform"); it was priced at 0.2-0.3 % of prefill wall
# before it was built and measured, correctly, as nothing outside the bands.
# 9bf594c (production 5-7, the persisted MLA tuner cache) is equally usable.
IMAGE=exl3-zeus:62f53e6

# Optional. Where the torch profiler writes its traces, one per rank. Unset =
# no profiler and no cost. Set it and POST /start_profile + /stop_profile work
# against a RUNNING engine, so a step-time breakdown costs a six-minute window
# rather than a boot. Note this vLLM takes it as --profiler-config only:
# VLLM_TORCH_PROFILER_DIR alone leaves the route unattached and the endpoint
# answering 404. Carry it in production; it is free when unset. docs/09
# section 4.1, results/profile/measured-prod7.md.
# PROFILER_DIR=/cache/prof
# The GB10 top-k overlay (patches/indexer-overlay/). Two vLLM files, mounted
# read-only over the image's copies.
OVERLAY_DIR=@HOME@/exl3-zeus/overlay
# Optional. The chat template shipped with the base model, 4 September 2026
# revision (md5 16ffa9ab6061be83657ecb9f58069808). Leave empty to use the one
# inside the checkpoint.
CHAT_TEMPLATE_HOST=@HOME@/exl3-zeus/chat_template.jinja
# The NCCL mesh plugin directory, mounted read-only at /opt/nccl-mesh. Production
# is a build of autoscriptlabs/nccl-mesh-plugin at 19924dcc with our patches
# 0004 + 0005 + 0006 applied (patches/kernel/). Keep the stock build in its own
# directory: switching between them is then one line, and rolling back never
# writes to the plugin you are rolling back to. docs/06 sections 6-8.
NCCL_MESH_PLUGIN_DIR=@HOME@/exl3-zeus/nccl-mesh-patched2

# --- Environment passed into the container ----------------------------------
# HAREM_DISABLE_PERSISTENT_TOPK=1  pins the DSA indexer to the decode fallback
#   top-k. Measured: it is not a workaround, it is faster below ~16K candidate
#   pools (about 64K tokens of context), and the selected sets match torch.topk
#   exactly. Above that crossover the persistent kernel wins. docs/05.
# NCCL_MAX_NCHANNELS=8  see the long note at the bottom of this file. docs/06.
# HAREM_SW_BLOCK_SIZE=256  the draft KV group's page size. Upstream gives an
#   independently grouped sliding-window spec the backend's smallest kernel
#   block (16 tokens), which then eats 53 % of the per-request block budget for
#   0.6 % of the memory. 256 is the measured optimum. docs/07.
# CUDA_EXL3_TUNE_CACHE=/cache/tune  persist the MLA decode tuner's picks across
#   processes (needs cuda-exl3 9bf594c or later; unset = upstream behaviour).
#   /cache is already bind-mounted to the host by scripts/start-tp3.sh, so the
#   file survives the container. Measured: 18 tune events before serving -> 0,
#   and the first sweep round stops being a penalty, which is what lets the
#   measurement protocol drop from five rounds to three. docs/12.
# NCCL_MESH_LINKS_PER_PEER=0  use ALL parallel cables to each peer (0 = all,
#   1 = the pre-patch single-cable behaviour). Needs patches/kernel/0005. On a
#   fabric with two cables per node pair the unpatched plugin puts every channel
#   on the first one and the second never carries a byte. 64 MB all-reduce
#   12.0 -> 16.7 GB/s. Check your own port_xmit_data counters. docs/06 section 6.
# NCCL_MESH_MIN_RNR_TIMER=1  IBTA code, 0.01 ms. The plugin hardcodes 12
#   (0.64 ms) with a comment saying 0.01. patches/kernel/0004. docs/06 section 5.
# NCCL_MESH_PTR_CUDA=1  advertise NCCL_PTR_CUDA so NCCL stops staging every
#   transfer through a host bounce buffer. Needs patches/kernel/0006. 64 MB
#   all-reduce 16.7 -> 20.8 GB/s. docs/06 section 7.
# NCCL_MESH_FLUSH=1  make mesh_iflush() a real RDMA_READ instead of a no-op.
#   Required for correctness once device pointers are advertised; its cost is
#   inside the run-to-run spread. Leave it on. docs/06 section 7.
# NOT set, and deliberately: NCCL_MESH_DMABUF=1 works on this platform and is
#   SLOWER than plain ibv_reg_mr (64 MB all-reduce 18.1 against 20.8). docs/06.
# HAREM_DRAFT_KV_DTYPE=fp8  put the DFlash2 drafter's OWN KV cache at fp8. The
#   launcher pins the draft cache to "auto" inside --speculative-config, where
#   auto means bf16 rather than "inherit"; a prelude patch overrides
#   SpeculativeConfig before validation, so the launcher is untouched and the
#   rollback is this one variable. Measured on a load boot: draft page
#   393,216 -> 196,608 B, per-block 21,917,440 -> 20,934,400 (-4.5 %), divisor
#   unchanged at 363, KV pool 4,449,035 -> 4,699,724 (+5.6 %). Draft acceptance,
#   speed and the gates are unchanged; TTFT improved. docs/07 section 7.
EXTRA_ENV="HAREM_DISABLE_PERSISTENT_TOPK=1 NCCL_MAX_NCHANNELS=8 HAREM_SW_BLOCK_SIZE=256 HAREM_DRAFT_KV_DTYPE=fp8 CUDA_EXL3_TUNE_CACHE=/cache/tune NCCL_MESH_LINKS_PER_PEER=0 NCCL_MESH_MIN_RNR_TIMER=1 NCCL_MESH_PTR_CUDA=1 NCCL_MESH_FLUSH=1"

# --block-size 256               prefix-cache block size; every KV group that
#                                joins the prefix cache must satisfy
#                                block_size % hash_block_size == 0 (asserted).
# --enable-ep-weight-filter      skip reading experts this rank does not own.
#                                Needs patches/tp3/patch-epfilter-tp3.py to
#                                recognise EXL3's .trellis suffix. docs/08.
# --safetensors-load-strategy eager   sequential read() per shard instead of
#                                mmap. Unused once the fast-load sidecar is in
#                                place, kept as the fallback path. docs/08.
# --no-enable-flashinfer-autotune  worth ~3.5 s, not the 34 s it appears to be:
#                                most of that work moves into graph capture.
EXTRA_ARGS="--block-size 256 --enable-ep-weight-filter --safetensors-load-strategy eager --no-enable-flashinfer-autotune"

# --- Fast-load sidecar (optional; docs/08) ----------------------------------
# Cuts boot from 618 s to 274 s. Leave FASTLOAD_MODE empty for upstream
# behaviour. Produce the sidecar with one FASTLOAD_MODE=dump boot first, then
# switch to load. Regenerate it whenever the checkpoint, image, patch set or
# TP/EP layout changes -- the manifest and the preflight will refuse a stale one
# rather than silently serving different weights. That is not theoretical: the
# move to the 9bf594c image cost one ~11-minute dump boot on every node. Name
# the directory after the image so two sidecars can coexist across a change.
# NOTE: adding HAREM_DRAFT_KV_DTYPE meant adding a prelude patch, and the
# identity covers every patch in the directory, so production configuration 7
# needed its own dump boot and its own sidecar directory. docs/09 section 11.
FASTLOAD_DIR=/var/tmp/glm53-exl3-zk1
FASTLOAD_MODE=load
FASTLOAD_VERIFY=32
FASTLOAD_SHARD_BYTES=2147483648

# ---------------------------------------------------------------------------
# NCCL_PROTO: leave UNSET.
# Measured model-free over the mesh, world = 3: Simple is 2.8x worse than auto
# at the 64 KB decode message and no better at the 16 MB prefill chunk (a whole
# decode step's collectives go 3.9 -> 10.0 ms). Forcing LL at 16 MB costs
# 20,114 us against auto's 1,787 us, so the tuner is not choosing LL there
# either. docs/06.
#
# NCCL_MAX_NCHANNELS=8 (set in EXTRA_ENV above).
# On this fabric NCCL opens 64 ring channels. The mesh plugin carries data with
# two-sided SEND/RECV, so a send that lands on a queue pair the receiver has not
# re-armed costs a 0.64 ms RNR stall (the plugin sets min_rnr_timer = 12, which
# is 0.64 ms in the IBTA encoding, while its comment says 0.01 ms -- that is
# code 1). With 64 channels the proxy thread's round-robin lap is long enough
# that this happens constantly between 200 KB and 12 MB, which is exactly where
# the C8 decode all-reduce (64 tok x 4096 x bf16 = 512 KB) sits. Capping the
# channels at 8 shortens the lap and the RNR counters fall to about zero:
# model-free, the 512 KB all-reduce goes 1,195 -> 123 us and one decode step's
# collectives 91.7 -> 9.9 ms. In the engine, five sweep rounds per arm with the
# first two discarded: C1 +6.7 %, C2 +9.4 %, C4 +11.8 %, C6 +7.6 %, C8 +12.6 %;
# prefill, gates, acceptance and KV pool unchanged. 12 channels measures the
# same model-free but was never taken to the engine. docs/06.
# ---------------------------------------------------------------------------
