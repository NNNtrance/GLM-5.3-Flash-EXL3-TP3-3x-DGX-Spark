                                    const half* __restrict__ suh, int m, int k, int groups)
@@ -104,6 +109,18 @@ __global__ void exl3_moe_had_in_kernel(const IN_T* __restrict__ x,
     // Surplus rows from the worst-case padding are never read by the gemm
