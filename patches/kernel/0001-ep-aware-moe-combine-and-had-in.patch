+
+    // Under expert parallel the gemm allocates with at::empty and returns early
+    // for a block whose expert lives on another rank, so those rows are never
+    // written. Reading them is not merely wrong, it is unbounded: recycled
+    // memory can hold a NaN bit pattern, and this rank's contribution goes
+    // straight into an all-reduce. Deciding it here costs one int load per
+    // (token, k) pair and saves both the H-wide read of a dead row and the
+    // separate (rows, H) clearing pass the caller would otherwise need.
+    // expert_ids == nullptr keeps the pre-EP behaviour exactly.
+    //
+    // Staging the row indices and the routing weights in shared memory is a
+    // second, unrelated win that comes free with the loop split: the original
+    // re-read inv[] and w[] from global for every h a thread owned, i.e.
+    // ceil(H/blockDim) times per thread per (token, k) pair.
+    __shared__ int s_row[MAX_TOPK];
+    __shared__ float s_w[MAX_TOPK];
+    if ((int) threadIdx.x < top_k)
+    {
+        int r = inv[token * top_k + threadIdx.x];
+        bool live = (expert_ids == nullptr) || (expert_ids[r / block_m] >= 0);
+        s_row[threadIdx.x] = live ? r : -1;
+        s_w[threadIdx.x] = w[token * top_k + threadIdx.x];
