     if (n_rows && row >= *n_rows) return;
+
+    // Retire a block that belongs to no expert BEFORE anything is written.
+    // Under expert parallel two thirds of the live blocks are remote, and the
+    // gemm retires them on the same predicate, so nothing downstream ever reads
+    // their activations -- not even the padding rows. Testing this after the
+    // padding branch (the original order) made every remote block still write
+    // 2*k zeros per padding row, which at decode is most of this kernel's
+    // traffic: at M=8, 288 experts, block_m=16 the live region is 944 rows of
+    // which ~880 are padding and ~2/3 of those sit in remote blocks.
+    int e = expert_ids[row / block_m];
+    if (e < 0) return;                  // block belongs to no expert
+
