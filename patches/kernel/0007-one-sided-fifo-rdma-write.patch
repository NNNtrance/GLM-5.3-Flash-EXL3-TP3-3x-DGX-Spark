+                            struct mesh_qp_info *remote_info,
+                            const struct mesh_qp_ext *local_ext,
+                            struct mesh_qp_ext *remote_ext, int *have_ext) {
     int sock;
     struct sockaddr_in addr;
     int connected = 0;
@@ -877,12 +1020,58 @@ int mesh_send_handshake(uint32_t remote_ip, uint16_t remote_port,
         close(sock);
