+/*
+ * ============================================================================
+ * patch 0007 -- one-sided data path: receiver-advertised FIFO + RDMA_WRITE
+ * ============================================================================
+ *
+ * The two-sided SEND/RECV path stays and is still the default. With
+ * NCCL_MESH_TRANSPORT=write the data path becomes the one NCCL's own IB
+ * transport uses:
+ *
+ *   - the SENDER owns a small ring of mesh_fifo_slot in host memory, registered
+ *     with IBV_ACCESS_REMOTE_WRITE, and advertises its address + rkey in the
+ *     handshake;
+ *   - mesh_irecv posts a zero-length RECV (to catch the immediate) and then
+ *     publishes one slot -- the receive buffer's address, rkey and size --
+ *     into the sender's ring with an inline RDMA_WRITE;
+ *   - mesh_isend waits for a published slot and issues one
+ *     IBV_WR_RDMA_WRITE_WITH_IMM straight into the receiver's buffer.
+ *
+ * Because the sender cannot write before the receiver has published, and the
+ * receiver publishes only after its zero-length RECV is armed, an RNR NAK is
+ * not reachable in the steady state at all -- instead of being made cheap by
+ * patch 0004's min_rnr_timer.
+ */
+#define MESH_TRANSPORT_SEND     0
+#define MESH_TRANSPORT_WRITE    1
+
+#define MESH_EXT_MAGIC          0x4D            /* 'M' -- mesh_qp_info.ext_magic */
+#define MESH_WIRE_VERSION       1               /* bump on ANY wire change      */
+#define MESH_EXT_STRUCT_MAGIC   0x4D583037u     /* "MX07"                       */
+
+#define MESH_FIFO_DEPTH_MIN     32              /* >= NCCL_NET_MAX_REQUESTS     */
+#define MESH_FIFO_DEPTH_MAX     4096
+#define MESH_FIFO_DEPTH_DEFAULT 128
+#define MESH_FIFO_SIGNAL_PERIOD 16              /* signal 1 in N slot publishes */
+
+/*
+ * One FIFO slot. 32 bytes, so it fits the QP's max_inline_data = 64 and the
+ * publish costs the NIC no extra DMA read.
+ *
+ * seq is written LAST on purpose: the sender treats the slot as ready when seq
+ * reaches the value it is waiting for. That relies on a single RDMA_WRITE
+ * landing in ascending address order, which is the same assumption NCCL's IB
+ * plugin ships with. NCCL_MESH_FIFO_STRICT=1 (the default) additionally checks
+ * seq_head, so a torn slot is detected and simply retried instead of used.
+ */
+struct mesh_fifo_slot {
+    uint64_t addr;          /*  0  receiver's buffer virtual address */
+    uint32_t rkey;          /*  8  receiver's rkey for that buffer   */
+    uint32_t size;          /* 12  bytes the receiver will accept    */
+    uint32_t tag;           /* 16  NCCL tag, echoed back             */
+    uint32_t seq_head;      /* 20  low half of seq, for STRICT mode  */
+    uint64_t seq;           /* 24  ready stamp -- WRITTEN LAST       */
 };
 
+/*
+ * Handshake extension, exchanged over the same TCP socket immediately after
+ * struct mesh_qp_info, and only when BOTH sides set ext_magic. Fixed size and
+ * self-describing (magic, version, struct_bytes, slot_bytes) so a mismatched
+ * pair fails loudly at connect instead of writing the wrong memory later.
+ * All multi-byte fields are in network byte order.
+ */
+struct mesh_qp_ext {
+    uint32_t magic;         /* MESH_EXT_STRUCT_MAGIC                 */
+    uint16_t version;       /* MESH_WIRE_VERSION                     */
+    uint8_t  transport;     /* MESH_TRANSPORT_SEND / _WRITE          */
+    uint8_t  slot_bytes;    /* sizeof(struct mesh_fifo_slot)         */
+    uint32_t fifo_depth;    /* slots in the sender's ring            */
+    uint32_t fifo_rkey;     /* rkey of the sender's ring             */
+    uint64_t fifo_addr;     /* address of the sender's ring          */
+    uint32_t struct_bytes;  /* sizeof(struct mesh_qp_ext)            */
+    uint8_t  reserved[36];
+};
+
+_Static_assert(sizeof(struct mesh_fifo_slot) == 32, "mesh_fifo_slot must stay 32 bytes");
+_Static_assert(sizeof(struct mesh_qp_ext) == 64, "mesh_qp_ext must stay 64 bytes");
+_Static_assert(sizeof(struct mesh_qp_info) == 32, "mesh_qp_info must stay 32 bytes");
