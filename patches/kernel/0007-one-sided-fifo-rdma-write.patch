+    if (local_info->ext_magic == MESH_EXT_MAGIC &&
+        remote_info->ext_magic == MESH_EXT_MAGIC) {
+        if (remote_info->ext_ver != MESH_WIRE_VERSION) {
+            MESH_WARN("connect: peer speaks MESH wire version %u, this node speaks %u "
+                      "- refusing (mixed plugin versions)",
