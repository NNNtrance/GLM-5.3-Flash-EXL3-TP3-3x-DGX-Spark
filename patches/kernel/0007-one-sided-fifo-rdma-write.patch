+/*
+ * ============================================================================
+ * patch 0007 -- handshake extension for the one-sided (FIFO + RDMA_WRITE) path
+ * ============================================================================
+ *
+ * struct mesh_qp_info stays 32 bytes on purpose: growing it would make an
+ * unpatched peer's MSG_WAITALL recv wait forever for bytes that never come.
+ * Instead its two spare bytes carry a magic and a wire version, and a fixed
+ * 64-byte struct mesh_qp_ext is exchanged afterwards -- but only when BOTH
+ * ends set the magic, so against a pre-0007 peer the wire is byte-identical
+ * to the unpatched plugin.
+ */
+
+/* Byte order for the 64-bit FIFO address on the wire. */
+static uint64_t mesh_hton64(uint64_t v) {
+    uint32_t probe = 1;
+    if (*(const uint8_t *)&probe == 0) return v;   /* already big-endian */
+    return ((uint64_t)htonl((uint32_t)(v & 0xffffffffULL)) << 32) |
+           (uint64_t)htonl((uint32_t)(v >> 32));
+}
+#define mesh_ntoh64(v) mesh_hton64(v)
+
+/* Clamp a requested FIFO depth into [MIN, MAX] and round up to a power of two
+ * so the ring index is a mask instead of a modulo. */
+static uint32_t mesh_fifo_pow2(int requested) {
+    uint32_t d = 1;
+    int want = requested;
+    if (want < MESH_FIFO_DEPTH_MIN) want = MESH_FIFO_DEPTH_MIN;
+    if (want > MESH_FIFO_DEPTH_MAX) want = MESH_FIFO_DEPTH_MAX;
+    while (d < (uint32_t)want) d <<= 1;
+    return d;
+}
+
+/* Fixed-size blocking helpers for the handshake socket. Both ends already set
+ * SO_SNDTIMEO/SO_RCVTIMEO, so a peer that speaks a different protocol produces
+ * a timeout and an error line -- never a silent hang. */
+static int mesh_sock_send_all(int sock, const void *buf, size_t len) {
+    const uint8_t *p = (const uint8_t *)buf;
+    size_t off = 0;
+    while (off < len) {
+        ssize_t n = send(sock, p + off, len - off, 0);
+        if (n <= 0) return -1;
+        off += (size_t)n;
+    }
+    return 0;
+}
+
+static int mesh_sock_recv_all(int sock, void *buf, size_t len) {
+    uint8_t *p = (uint8_t *)buf;
+    size_t off = 0;
+    while (off < len) {
+        ssize_t n = recv(sock, p + off, len - off, 0);
+        if (n <= 0) return -1;
+        off += (size_t)n;
+    }
+    return 0;
+}
+
+/* Fill the extension this node advertises. The accept side owns no ring, so
+ * it passes zeroes for the FIFO fields. */
+static void mesh_ext_fill(struct mesh_qp_ext *ext, uint64_t fifo_addr,
+                          uint32_t fifo_rkey, uint32_t fifo_depth) {
+    memset(ext, 0, sizeof(*ext));
+    ext->magic        = htonl(MESH_EXT_STRUCT_MAGIC);
+    ext->version      = htons(MESH_WIRE_VERSION);
+    ext->transport    = (uint8_t)g_mesh_state.transport;
+    ext->slot_bytes   = (uint8_t)sizeof(struct mesh_fifo_slot);
+    ext->fifo_depth   = htonl(fifo_depth);
+    ext->fifo_rkey    = htonl(fifo_rkey);
+    ext->fifo_addr    = mesh_hton64(fifo_addr);
+    ext->struct_bytes = htonl((uint32_t)sizeof(struct mesh_qp_ext));
+}
+
+/*
+ * Validate a peer's extension. Fail-closed: anything that does not match
+ * exactly is refused here, at connect time, instead of being discovered later
+ * as a write into the wrong memory.
+ *
+ * have_ext == 0 means the peer never set ext_magic, i.e. it predates patch
+ * 0007. That is fine in send mode -- the data path is then the old two-sided
+ * one and the wire is identical -- and fatal in write mode.
+ *
+ * need_fifo is 1 only where the peer is the sender and must therefore have
+ * advertised a ring (the accept side of the handshake).
+ */
+static int mesh_ext_validate(const struct mesh_qp_ext *ext, int have_ext,
+                             int need_fifo, const char *who) {
+    if (!have_ext) {
+        if (g_mesh_state.transport == MESH_TRANSPORT_WRITE) {
+            MESH_WARN("%s: peer does not speak the MESH write transport (no "
+                      "handshake extension). Every node must run a plugin with "
+                      "patch 0007 and the same NCCL_MESH_TRANSPORT. Refusing.", who);
+            return -1;
+        }
+        return 0;
+    }
+    if (ntohl(ext->magic) != MESH_EXT_STRUCT_MAGIC) {
+        MESH_WARN("%s: handshake extension magic 0x%08x, expected 0x%08x - refusing",
+                  who, ntohl(ext->magic), MESH_EXT_STRUCT_MAGIC);
+        return -1;
+    }
+    if (ntohs(ext->version) != MESH_WIRE_VERSION) {
+        MESH_WARN("%s: peer speaks MESH wire version %u, this node speaks %u - "
+                  "refusing (mixed plugin versions)", who,
+                  (unsigned)ntohs(ext->version), (unsigned)MESH_WIRE_VERSION);
+        return -1;
+    }
+    if (ntohl(ext->struct_bytes) != (uint32_t)sizeof(struct mesh_qp_ext) ||
+        ext->slot_bytes != (uint8_t)sizeof(struct mesh_fifo_slot)) {
+        MESH_WARN("%s: handshake extension layout mismatch (ext %u vs %zu, slot %u "
+                  "vs %zu) - refusing", who, ntohl(ext->struct_bytes),
+                  sizeof(struct mesh_qp_ext), (unsigned)ext->slot_bytes,
+                  sizeof(struct mesh_fifo_slot));
+        return -1;
+    }
+    if (ext->transport != (uint8_t)g_mesh_state.transport) {
+        MESH_WARN("%s: peer runs NCCL_MESH_TRANSPORT=%s, this node runs %s - "
+                  "refusing (both ends must agree)", who,
+                  ext->transport == MESH_TRANSPORT_WRITE ? "write" : "send",
+                  g_mesh_state.transport == MESH_TRANSPORT_WRITE ? "write" : "send");
+        return -1;
+    }
+    if (need_fifo && g_mesh_state.transport == MESH_TRANSPORT_WRITE) {
+        uint32_t d = ntohl(ext->fifo_depth);
+        if (d < MESH_FIFO_DEPTH_MIN || d > MESH_FIFO_DEPTH_MAX || (d & (d - 1)) ||
+            ext->fifo_addr == 0) {
+            MESH_WARN("%s: peer advertised an unusable FIFO (depth %u, addr %s) - "
+                      "refusing", who, d, ext->fifo_addr ? "set" : "null");
+            return -1;
+        }
+    }
+    return 0;
+}
+
+/* Defined with the rest of the one-sided data path, below mesh_regMr. */
+static int  mesh_send_fifo_setup(struct mesh_send_comm *comm);
+static void mesh_send_fifo_teardown(struct mesh_send_comm *comm);
+static int  mesh_send_drain(struct mesh_send_comm *comm);
+static void mesh_untrack_request(struct mesh_request *req);
