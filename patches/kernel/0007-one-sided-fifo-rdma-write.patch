+                      "expected %llu. Raise NCCL_MESH_FIFO_DEPTH (currently %u).",
+                      comm->qp ? comm->qp->qp_num : 0,
+                      (unsigned)(comm->fifo_tail & comm->fifo_mask),
+                      (unsigned long long)seq, (unsigned long long)want,
