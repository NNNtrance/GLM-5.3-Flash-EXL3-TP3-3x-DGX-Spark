     close(sock);
     return 0;
 }
 
+/*
+ * Extension-free entry point, kept for the async connect path (TICKET-7).
+ * local_info->ext_magic is zero there, so no extension is exchanged and the
+ * wire is exactly what it was before patch 0007.
+ */
+int mesh_send_handshake(uint32_t remote_ip, uint16_t remote_port,
+                        struct mesh_qp_info *local_info, struct mesh_qp_info *remote_info) {
+    if (g_mesh_state.transport == MESH_TRANSPORT_WRITE) {
+        MESH_WARN("async connect is not supported by the write transport "
+                  "(it never exchanges a FIFO advertisement) - refusing");
+        return -1;
+    }
+    return mesh_send_handshake_ext(remote_ip, remote_port, local_info, remote_info,
+                                   NULL, NULL, NULL);
+}
