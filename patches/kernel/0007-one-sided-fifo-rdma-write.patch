+static int mesh_fifo_ready(struct mesh_send_comm *comm, struct mesh_fifo_slot *out) {
+    struct mesh_fifo_slot *slot = &comm->fifo[comm->fifo_tail & comm->fifo_mask];
+    uint64_t want = comm->fifo_tail + 1;
