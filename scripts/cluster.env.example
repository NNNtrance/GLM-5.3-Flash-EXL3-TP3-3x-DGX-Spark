# Copy to scripts/cluster.env and edit. That path is gitignored, so your real
# addresses never reach a commit -- which is the point.
#
#   cp scripts/cluster.env.example scripts/cluster.env
#
# Read by audit/run-audit.sh. The engine itself is configured from envs/, not
# from this file; this is only for the measurement and audit scripts.

# The OpenAI-compatible endpoint. Only rank 0 serves it.
API=http://192.0.2.10:8001

# Rank 0. The audit reads the engine log from here.
HEAD_HOST=192.0.2.10

# All three, in any order. Used for the per-node version, fabric and memory checks.
NODES="192.0.2.10 192.0.2.11 192.0.2.12"

# The container name scripts/start-tp3.sh gives the engine.
CONTAINER=exl3-tp3

# How the audit reaches the other nodes. Key-based, non-interactive, no TTY.
SSH="ssh -o BatchMode=yes -n"
