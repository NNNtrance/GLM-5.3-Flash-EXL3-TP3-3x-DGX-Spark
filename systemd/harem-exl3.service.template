[Unit]
Description=GLM-5.3-Flash EXL3 engine (exl3-zeus image, TP=3 + EP, cuda-exl3) - starts at boot [TEMPLATE, NOT INSTALLED]
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
Environment=ENV_FILE=@HOME@/exl3-zeus/.env.tp3
Environment=HOME=@HOME@
WorkingDirectory=@HOME@/exl3-zeus
ExecStartPre=/bin/bash @HOME@/exl3-zeus/motor-onkosul-exl3.sh
ExecStart=/bin/bash -c "ENV_FILE=@HOME@/exl3-zeus/.env.tp3 exec bash @HOME@/exl3-zeus/tp3/start-tp3.sh"
ExecStop=/usr/bin/docker stop -t 60 harem_glm53_lil
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
