[Unit]
Description=GLM-5.3-Flash EXL3 engine (TP=2 recipe: two nodes, candidate C, tp2c tree)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
# Two engines can never run on one node's unified memory. This unit and the
# three-node one are alternatives, not siblings: enable exactly one of them.
Conflicts=harem-exl3.service harem-motor.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
Environment=ENV_FILE=@HOME@/exl3-zeus/.env.tp2c-load
Environment=HOME=@HOME@
WorkingDirectory=@HOME@/exl3-zeus/tp2c
ExecStartPre=/bin/bash @HOME@/exl3-zeus/motor-onkosul-exl3-tp2.sh
ExecStart=/bin/bash @HOME@/exl3-zeus/tp2c/start-tp2full.sh
ExecStop=/usr/bin/docker stop -t 60 exl3-tp2
TimeoutStartSec=1200

[Install]
WantedBy=multi-user.target
