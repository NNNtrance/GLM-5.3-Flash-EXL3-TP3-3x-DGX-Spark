# ---------------------------------------------------------------------------
# .env.tp3-full -- GLM-5.3-Flash FULL-SCOPE EXL3, TP=3 + expert parallel +
# DFlash2 k=7. This is production configuration 9.
#
# It is env.tp3.example with eight lines changed. Everything not repeated here
# -- the NCCL notes, the memory ladder, the block-size reasoning -- is in
# env.tp3.example and applies unchanged; read that file first.
#
# ONE COPY PER NODE, derived on that node, never copied between nodes. On our
# cluster it is produced by tracks/tp3/patches/mk-env-tp3full.sh, which sed-derives
# it from each node's own .env.tp3 and therefore keeps NODE_RANK, HOST_IP,
# OVERLAY_DIR, NCCL_MESH_PLUGIN_DIR and CHAT_TEMPLATE_HOST correct by
# construction. See envs/README.md.
#
# Placeholders to replace:
#   @NODE_RANK@    0 on the head node, 1 on worker-1, 2 on worker-2
#   @HOST_IP@      this node's own management address
#   @HEAD_IP@      the head node's management address (same on all three)
#   @IFACE@        the management network interface name
#   @HOME@         this node's home directory
#
# Consumed by scripts/start-tp3.sh. Launch order: rank 2, then 1, then 0.
# ---------------------------------------------------------------------------

NODE_RANK=@NODE_RANK@
HOST_IP=@HOST_IP@

MASTER_ADDR=@HEAD_IP@
MASTER_PORT=29531
GLOO_IFACE=@IFACE@
FABRIC_PREFIX=
TRANSPORT=mesh

# --- Parallelism ------------------------------------------------------------
NNODES=3
TP_SIZE=3
# Still mandatory. Full scope quantizes the dense path, not the routed experts:
# they are 4-bit EXL3 in both checkpoints, moe_intermediate_size is still 2048,
# and 2048/3 is still not an integer. docs/03, docs/13.
ENABLE_EP=1

# --- Model and drafter ------------------------------------------------------
# CHANGED: the full-scope checkpoint and its own sidecar. Both sidecars are
# relative symlink trees, so each is mounted at its own host path (identity
# mount) and the launcher refuses anything else. Do NOT set MODEL_PATH.
# Build this sidecar with tracks/tp3/patches/pad-tp3full.py -- it writes the padded
# config.json AND the rewritten quantization_config.json that carries the packed
# mapping. patches/tp3/pad-tp3.py does not, and the load then fails. docs/13.
MODEL_HOST_PATH=/var/tmp/glm-5.3-flash-turboderp-4.05bpw-tp3
MODEL_LINK_TARGET=/var/tmp/glm-5.3-flash-turboderp-4.05bpw
DRAFT_HOST_PATH=/var/tmp/dflash2-draft-tp3
DRAFT_LINK_TARGET=/var/tmp/dflash2-draft

SPEC_METHOD=dflash
SPEC_TOKENS=7

# --- Serving ----------------------------------------------------------------
PORT=8001
SERVED_MODEL_NAME=glm-5.3-flash
QUANTIZATION=exl3
ATTENTION_BACKEND=CUSTOM
KV_CACHE_DTYPE=fp8
MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=2048
ENFORCE_EAGER=0
LANGUAGE_MODEL_ONLY=1
REASONING_PARSER=deepseek_r1
REASONING_EFFORT=low
CPUSET=5-9,15-19

# --- Memory -----------------------------------------------------------------
# UNCHANGED from production 8 on purpose. The KV pool is this arm's measured
# output, not one of its inputs: it came out at 5,165,289 tokens against
# production 8's 4,696,969, +10.0 %, because full scope consumes 3.4 GiB LESS
# per node. Moving the ladder is a separate arm. docs/13 section 7.2.
GPU_MEMORY_UTILIZATION=0.80
SETTLE_MIN_GIB=112

# --- Image ------------------------------------------------------------------
# CHANGED, and this one is not optional. The padded-load path needs cuda-exl3
# f3e3090 (a padded output dim is accepted when the pad is whole 128-blocks,
# with svh allocated zeroed; and the row-parallel suh load copies what exists
# and zeros the rest) AND 754421f (the vocab loaders fill a prefix instead of
# copy_ing an unpadded slice into a padded parameter). On 62f53e6 or 5903248 the
# boot raises "EXL3 weights cannot be zero-extended" in create_weights; on
# f3e3090 alone it passes that gate and then dies on a copy_ shape mismatch in
# _vocab_loaders. tracks/tp3/patches/check-padload-tp3.py reads all three
# capabilities out of the installed source in the prelude and exits 23 before a
# byte of weight is read. docs/13 section 7.
IMAGE=exl3-zeus:754421f

OVERLAY_DIR=@HOME@/exl3-zeus/overlay
CHAT_TEMPLATE_HOST=@HOME@/exl3-zeus/chat_template.jinja
NCCL_MESH_PLUGIN_DIR=@HOME@/exl3-zeus/nccl-mesh-patched2
# PROFILER_DIR=/cache/prof

# --- The patch tree ---------------------------------------------------------
# CHANGED. /opt/harem-tp3 and /start.sh are mounted from here. The production
# tp3/ directory is deliberately untouched: its file list is the fast-load
# manifest identity, and adding a single file to it has already refused a
# production boot twice. docs/08 section 4, docs/09 section 11.2.
TP3_DIR=@HOME@/exl3-zeus/tp3full

# --- Environment passed into the container ----------------------------------
# CHANGED: + HAREM_EXL3_FULLSCOPE=1. One knob for S1+S2+S3+A9+A10. With it
# unset the patched image is upstream byte for byte and still serves the
# routed-experts-only checkpoint, because the patch reads the knob at run time
# and takes the split decision from the checkpoint rather than the environment.
# That is the one-line rollback for this whole arm. docs/13 section 3.
EXTRA_ENV="HAREM_DISABLE_PERSISTENT_TOPK=1 NCCL_MAX_NCHANNELS=8 HAREM_SW_BLOCK_SIZE=256 HAREM_DRAFT_KV_DTYPE=fp8 CUDA_EXL3_TUNE_CACHE=/cache/tune NCCL_MESH_LINKS_PER_PEER=0 NCCL_MESH_MIN_RNR_TIMER=1 NCCL_MESH_PTR_CUDA=1 NCCL_MESH_FLUSH=1 HAREM_TILELANG_FAILLOUD=1 HAREM_EXL3_FULLSCOPE=1"

# CUDA_EXL3_DEBUG_NAMES=1 is a boot gate rather than a setting: since cuda-exl3
# 807d798 it logs at warning and reports the modules that RESOLVED as well as
# those that stayed BF16, with running tallies. Expected on this checkpoint:
# 203 EXL3 / 113 bf16, and nothing heavy in the "-> unquantized" list. Reading
# it is the acceptance gate; leaving it on costs a few log lines. docs/09.
CUDA_EXL3_DEBUG_NAMES=1

# --- Launcher arguments -----------------------------------------------------
# CHANGED, and note the SINGLE quotes. This checkpoint's inlined quantization
# config carries no tensor_storage, so cuda-exl3 has to be pointed at the
# standalone file -- which the sidecar rewrote to carry the packed mapping as
# well. In double quotes the shell eats the JSON's own quotes; the JSON must
# also contain NO SPACES, because start-tp3.sh word-splits these arguments.
# From cuda-exl3 fba9f27 onwards the same JSON can travel in
# CUDA_EXL3_PACKED_MAPPING instead -- same no-spaces rule.
EXTRA_ARGS='--block-size 256 --enable-ep-weight-filter --safetensors-load-strategy eager --no-enable-flashinfer-autotune --hf-overrides {"quantization_config_file":"/var/tmp/glm-5.3-flash-turboderp-4.05bpw-tp3/quantization_config.json"}'

# --- Fast-load sidecar ------------------------------------------------------
# CHANGED: a new directory name. Four inputs to the manifest identity moved at
# once (checkpoint, sidecar config, patch tree, image), so the previous sidecar
# cannot be used under any circumstances -- and reusing the NAME would have
# overwritten production 8's sidecar during the dump, because the launcher
# mounts this directory read-write in dump mode. Take one FASTLOAD_MODE=dump
# boot (about 620 s here), pass the gates, then switch to load (251 s, of which
# 58 s is weights). docs/08.
FASTLOAD_DIR=/var/tmp/glm53-exl3-full
FASTLOAD_MODE=load
FASTLOAD_VERIFY=32
FASTLOAD_SHARD_BYTES=2147483648

# ---------------------------------------------------------------------------
# Rolling back to production 8 is one file: keep the old env under a name that
# says what it was (ours is .env.tp3.bak-prod8-62f53e6) and start with
# ENV_FILE pointing at it. That reverts the checkpoint, the image, the patch
# tree and the sidecar in one move, because all four are named in this file.
# ---------------------------------------------------------------------------
